# DevOpsHub Backend Environment Configuration Template

# Server Port
PORT=4000

# Node Environment (production / development)
NODE_ENV=development

# JWT Secrets (Generate a strong cryptographically random secret in production)
JWT_SECRET=local_development_secret

# Encryption Key (Must be a 32-byte hex-encoded key for AES-256-GCM. 
# Generate via: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# Production CORS config (Domain of the React frontend app)
FRONTEND_URL=http://localhost:5173

# SQLite Database path (Prisma matches this)
DATABASE_URL="file:./dev.db"

# SMTP Production Mailer settings (Optional for local testing fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_SECURE=false
