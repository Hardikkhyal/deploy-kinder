datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  username     String?
  googleId     String?          @unique
  githubToken  String?
  createdAt    DateTime         @default(now())
  projects     Project[]
  awsCreds     AwsCredential[]
  instances    ServerInstance[]
}

model AwsCredential {
  id              String           @id @default(uuid())
  userId          String
  name            String
  accessKeyId     String
  secretAccessKey String
  region          String           @default("us-east-1")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instances       ServerInstance[]
}

model ServerInstance {
  id            String         @id @default(uuid())
  userId        String
  awsCredId     String?
  name          String
  publicIp      String
  sshUser       String         @default("ubuntu")
  sshPrivateKey String
  awsInstanceId String?
  awsCredential AwsCredential? @relation(fields: [awsCredId], references: [id], onDelete: SetNull)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects      Project[]
}

model Project {
  id          String         @id @default(uuid())
  userId      String
  serverId    String
  name        String
  repoUrl     String
  branch      String         @default("main")
  port        Int            @default(8080)
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  server      ServerInstance @relation(fields: [serverId], references: [id], onDelete: Cascade)
  deployments Deployment[]
}

model Deployment {
  id          String            @id @default(uuid())
  projectId   String
  commitId    String?
  status      String
  buildLogs   String?
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stages      DeploymentStage[]
}

model DeploymentStage {
  id             String     @id @default(uuid())
  deploymentId   String
  name           String
  status         String     // PENDING, RUNNING, SUCCESS, FAILED, SKIPPED
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  logs           String     @default("")
  errorReason    String?
  possibleCauses String?
  suggestedFix   String?
  canRetry       Boolean    @default(false)
  deployment     Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
