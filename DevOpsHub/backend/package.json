        "bcryptjs": "^2.4.3",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "nodemailer": "^9.0.1",
        "socket.io": "^4.8.3",
        "ssh2": "^1.17.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.0.0",
        "@types/nodemailer": "^8.0.1",
        "@types/ssh2": "^1.15.5",
        "prisma": "^5.22.0",
        "ts-node-dev": "^2.0.0",
